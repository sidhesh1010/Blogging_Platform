# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True

# Security Key (Generate a random 32-character string in production)
SECRET_KEY=dev-secret-key-change-in-production-blogsphere-2026

# Database Configuration
# Default is SQLite for local development:
DATABASE_URL=sqlite:///blogsphere.db
# PostgreSQL for production (example):
# DATABASE_URL=postgresql://username:password@localhost:5432/blogsphere_prod
